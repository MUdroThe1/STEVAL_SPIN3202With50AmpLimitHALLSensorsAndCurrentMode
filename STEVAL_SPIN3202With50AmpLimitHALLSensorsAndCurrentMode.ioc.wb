# Signal Setting                                                                                                       #
PA12.Signal=S_TIM1_ETR
SH.S_TIM1_ETR.0=TIM1_ETR,ETR-as-clearing-source
SH.S_TIM1_ETR.ConfNb=1

#......................................................................................................................#
#                                             PWM_pin_setting PHASE_UH TIM1                                            #
